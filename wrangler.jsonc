{
  // Must match the Worker's name in the Cloudflare dashboard exactly,
  // otherwise deploying creates a second Worker.
  "name": "personal-website",
  "compatibility_date": "2026-11-01",

  // Only runs for requests that don't match a static file (i.e. /api/contact).
  "main": "src/worker.js",

  // Serve the repo root as static files, minus what .assetsignore lists.
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
  },

  // Keeps Worker logs (console.error) visible in the dashboard.
  "observability": {
    "enabled": true,
  },
}
